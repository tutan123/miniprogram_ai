<view class="container">
  <view class="form-group">
    <view class="item">
      <text class="label">收货人</text>
      <input class="input" placeholder="名字" model:value="{{realName}}" />
    </view>
    <view class="item">
      <text class="label">手机号</text>
      <input class="input" placeholder="11位手机号" type="number" model:value="{{phone}}" />
    </view>
    <view class="item">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="街道、楼牌号等" model:value="{{address}}"></textarea>
    </view>
  </view>

  <button class="save-btn" bindtap="onSave">保存地址</button>
</view>

