<view class="container">
  <!-- 顶部积分大卡片 -->
  <view class="header-card">
    <view class="points-circle">
      <text class="points-num">{{points}}</text>
      <text class="points-label">我的积分</text>
    </view>
    <!-- 装饰背景 -->
    <view class="decoration-circle"></view>
  </view>

  <!-- 切换 Tab -->
  <view class="tab-header">
    <view class="tab-item {{currentTab === 'tasks' ? 'active' : ''}}" bindtap="switchTab" data-tab="tasks">
      📅 每日任务
      <view class="indicator" wx:if="{{currentTab === 'tasks'}}"></view>
    </view>
    <view class="tab-item {{currentTab === 'shop' ? 'active' : ''}}" bindtap="switchTab" data-tab="shop">
      🎁 积分商店
      <view class="indicator" wx:if="{{currentTab === 'shop'}}"></view>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="list-container" wx:if="{{currentTab === 'tasks'}}">
    <block wx:for="{{tasks}}" wx:key="id">
      <view class="task-item {{item.is_completed ? 'completed' : ''}}">
        <view class="icon-wrap {{item.type === 'daily' ? 'daily' : 'weekly'}}">
          {{item.type === 'daily' ? '日' : '周'}}
        </view>
        <view class="task-info">
          <text class="task-title">{{item.title}}</text>
          <text class="task-reward">+{{item.reward}} 积分</text>
        </view>
        
        <button wx:if="{{!item.is_completed}}" class="task-btn" bindtap="onCompleteTask" data-id="{{item.id}}">去打卡</button>
        <button wx:else class="task-btn disabled" disabled>已完成</button>
      </view>
    </block>
    
    <view wx:if="{{tasks.length === 0}}" class="empty-tip">暂无任务</view>
  </view>

  <!-- 商品列表 -->
  <view class="grid-container" wx:if="{{currentTab === 'shop'}}">
    <block wx:for="{{products}}" wx:key="id">
      <view class="product-item">
        <view class="product-img-placeholder">商品图</view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">{{item.price}} 积分</text>
          <button class="exchange-btn" bindtap="onExchangeProduct" data-id="{{item.id}}">兑换</button>
        </view>
      </view>
    </block>
    <view wx:if="{{products.length === 0}}" class="empty-tip">暂无商品</view>
  </view>
</view>
