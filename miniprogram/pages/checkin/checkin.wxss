/* pages/checkin/checkin.wxss */
.container {
  background-color: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部大卡片 */
.header-card {
  background: linear-gradient(135deg, #00b894, #00cec9);
  height: 360rpx;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.points-circle {
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: white;
  background: rgba(255, 255, 255, 0.15);
  padding: 40rpx 60rpx;
  border-radius: 40rpx;
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.points-num {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1;
}

.points-label {
  font-size: 26rpx;
  margin-top: 10rpx;
  opacity: 0.9;
}

/* 装饰背景圆 */
.decoration-circle {
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

/* Tab 切换 */
.tab-header {
  display: flex;
  background: white;
  margin: -60rpx 40rpx 30rpx; /* 负边距上移 */
  border-radius: 30rpx;
  padding: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #636e72;
  position: relative;
  font-weight: 500;
  transition: all 0.3s;
}

.tab-item.active {
  color: #00b894;
  font-weight: bold;
}

.indicator {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #00b894;
  border-radius: 4rpx;
}

/* 任务列表 */
.list-container {
  padding: 0 40rpx;
}

.task-item {
  background: white;
  padding: 30rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.task-item.completed {
  background-color: #f1f2f6;
  box-shadow: none;
}

.icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: bold;
  margin-right: 24rpx;
  font-size: 32rpx;
}

.icon-wrap.daily {
  background: linear-gradient(135deg, #0984e3, #74b9ff);
}

.icon-wrap.weekly {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
}

.task-info {
  flex: 1;
}

.task-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3436;
}

.task-reward {
  font-size: 26rpx;
  color: #fdcb6e;
  margin-top: 8rpx;
  display: block;
  font-weight: bold;
}

.task-btn {
  margin: 0 !important;
  font-size: 26rpx;
  background: #00b894;
  color: white;
  border-radius: 40rpx;
  padding: 12rpx 34rpx;
  font-weight: normal;
  min-width: 140rpx;
}

.task-btn.disabled {
  background: #b2bec3;
  color: white;
}

/* 商品网格 */
.grid-container {
  padding: 0 40rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.product-item {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
}

/* 修复图片高度 */
.product-img {
  width: 100%;
  height: 220rpx;
  background: #dfe6e9;
}

.product-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3436;
  margin-bottom: 12rpx;
}

.product-price {
  color: #00b894;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.exchange-btn {
  width: 100% !important;
  margin: 0 !important;
  background: #e17055;
  color: white;
  font-size: 26rpx;
  border-radius: 30rpx;
  padding: 10rpx 0;
}

.empty-tip {
  text-align: center;
  color: #b2bec3;
  margin-top: 60rpx;
  font-size: 28rpx;
}
