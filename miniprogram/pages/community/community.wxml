<view class="container">
  <!-- 帖子流 -->
  <scroll-view scroll-y class="post-list" refresher-enabled="{{true}}" bindrefresherrefresh="onRefresh" refresher-triggered="{{isRefreshing}}">
    <block wx:for="{{posts}}" wx:key="id">
      <view class="post-card">
        <view class="card-header">
          <view class="avatar-circle">{{item.nickname[0]}}</view>
          <view class="user-meta">
            <text class="user-name">{{item.nickname}}</text>
            <text class="post-time">{{item.created_at}}</text>
          </view>
        </view>
        
        <view class="card-body">
          <text class="post-title">{{item.title}}</text>
          <text class="post-content">{{item.content}}</text>
        </view>
        
        <view class="card-footer">
          <view class="action-btn" bindtap="onLikePost" data-id="{{item.id}}">
            <text class="heart-icon">❤️</text>
            <text class="like-count">{{item.likes}}</text>
          </view>
          <view class="action-btn">
            <text>💬 评论</text>
          </view>
        </view>
      </view>
    </block>
    
    <view wx:if="{{posts.length === 0}}" class="empty-state">
      <image src="/images/icons/goods.png" mode="aspectFit" style="width: 100rpx; height: 100rpx; opacity: 0.3;"></image>
      <text>还没有人发帖，来做第一个吧~</text>
    </view>
  </scroll-view>

  <!-- 悬浮发布按钮 -->
  <view class="fab-btn" bindtap="onShowCreateModal">
    <text class="fab-icon">+</text>
  </view>

  <!-- 弹窗 -->
  <view class="modal-mask {{showCreateModal ? 'visible' : ''}}" bindtap="onCloseCreateModal">
    <view class="modal-panel" catchtap="stopProp">
      <view class="modal-title">发布新动态</view>
      <input class="input-field" placeholder="取个吸引人的标题..." model:value="{{newTitle}}" />
      <textarea class="textarea-field" placeholder="分享你的打卡心得..." model:value="{{newContent}}" maxlength="200"></textarea>
      <view class="modal-actions">
        <button class="cancel-btn" bindtap="onCloseCreateModal">取消</button>
        <button class="submit-btn" bindtap="onSubmitPost">发布</button>
      </view>
    </view>
  </view>
</view>
