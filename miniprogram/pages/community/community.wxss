/* 社区页面美化 */
.container {
  background-color: #f8f9fa;
  height: 100vh;
  position: relative;
}

.post-list {
  height: 100%;
  box-sizing: border-box;
  padding: 20rpx;
}

.post-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
  transition: all 0.3s;
}

.post-card:active {
  transform: scale(0.99);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-circle {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  border-radius: 50%;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-weight: 600;
  font-size: 30rpx;
  color: #2d3436;
}

.post-time {
  font-size: 22rpx;
  color: #b2bec3;
  margin-top: 4rpx;
}

.card-body {
  margin-bottom: 24rpx;
}

.post-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #2d3436;
  margin-bottom: 12rpx;
}

.post-content {
  font-size: 28rpx;
  color: #636e72;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-footer {
  border-top: 1rpx solid #f1f2f6;
  padding-top: 20rpx;
  display: flex;
  justify-content: space-between;
}

.action-btn {
  display: flex;
  align-items: center;
  color: #636e72;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  background: #f1f2f6;
  border-radius: 30rpx;
}

.heart-icon {
  margin-right: 8rpx;
}

/* 悬浮按钮 */
.fab-btn {
  position: absolute;
  bottom: 60rpx;
  right: 40rpx;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #0984e3, #74b9ff);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(9, 132, 227, 0.4);
  z-index: 10;
}

.fab-icon {
  color: white;
  font-size: 60rpx;
  font-weight: 300;
  margin-top: -6rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.modal-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.modal-panel {
  width: 100%;
  background: white;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 40rpx;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.modal-mask.visible .modal-panel {
  transform: translateY(0);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.input-field {
  background: #f1f2f6;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.textarea-field {
  background: #f1f2f6;
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  font-size: 30rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.cancel-btn, .submit-btn {
  flex: 1;
  border-radius: 50rpx;
  font-size: 30rpx;
}

.cancel-btn {
  background: #dfe6e9;
  color: #636e72;
}

.submit-btn {
  background: #0984e3;
  color: white;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
  color: #b2bec3;
  font-size: 28rpx;
  gap: 20rpx;
}
