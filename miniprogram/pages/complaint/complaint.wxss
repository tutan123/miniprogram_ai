.container {
  background-color: #f8f9fa;
  min-height: 100vh;
  padding: 40rpx;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2d3436;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #b2bec3;
  margin-top: 10rpx;
}

.form-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.03);
}

.type-selector {
  display: flex;
  background: #f1f2f6;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #636e72;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.type-item.active {
  background: white;
  color: #2d3436;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.input-group {
  margin-bottom: 30rpx;
  position: relative;
}

.content-input {
  width: 100%;
  height: 240rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.counter {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  font-size: 22rpx;
  color: #b2bec3;
}

.contact-input {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.submit-btn {
  background: #6c5ce7;
  color: white;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 10rpx 20rpx rgba(108, 92, 231, 0.3);
}

