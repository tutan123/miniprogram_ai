.container {
  position: relative;
  width: 100%;
  height: 100vh;
}

.controls {
  position: absolute;
  bottom: 50rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 10;
}

.btn {
  background: white;
  padding: 20rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.btn.primary {
  background: #07c160;
  color: white;
}

/* 兴趣点详情弹窗 */
.poi-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.poi-detail-content {
  width: 90%;
  max-width: 600rpx;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
}

.poi-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.poi-detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.poi-detail-close {
  font-size: 40rpx;
  color: #999;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

.poi-detail-body {
  margin-bottom: 30rpx;
}

.poi-detail-info {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.poi-info-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.poi-info-value {
  font-size: 28rpx;
  color: #333;
}

.poi-detail-description {
  margin-top: 20rpx;
  line-height: 1.8;
}

.poi-description-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.poi-detail-footer {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.poi-nav-btn {
  width: 100%;
  background: #007AFF;
  color: white;
  border: none;
  border-radius: 10rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.poi-nav-btn::after {
  border: none;
}

.poi-nav-btn-hover {
  opacity: 0.8;
}

/* 路线信息提示 */
.route-info {
  position: absolute;
  top: 20rpx;
  left: 30rpx;
  right: 30rpx;
  background: rgba(0, 122, 255, 0.9);
  color: white;
  padding: 20rpx 30rpx;
  border-radius: 10rpx;
  z-index: 100;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.route-info-text {
  font-size: 28rpx;
  font-weight: bold;
}

