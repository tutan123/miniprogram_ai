<view class="container">
  <view class="header-bg"></view>

  <view class="profile-card">
    <block wx:if="{{!hasUserInfo}}">
      <view class="avatar-placeholder" bindtap="getUserProfile">?</view>
      <button class="login-btn" bindtap="getUserProfile">点击登录</button>
    </block>
    <block wx:else>
      <image class="avatar" src="{{userInfo.avatarUrl}}"></image>
      <text class="nickname">{{userInfo.nickName}}</text>
      <view class="badge">Lv.1 探索者</view>
    </block>
  </view>

  <view class="stats-row">
    <view class="stat-box">
      <text class="stat-num">{{points}}</text>
      <text class="stat-label">积分</text>
    </view>
    <view class="divider"></view>
    <view class="stat-box">
      <text class="stat-num">{{checkinDays}}</text>
      <text class="stat-label">打卡天数</text>
    </view>
    <view class="divider"></view>
    <view class="stat-box">
      <text class="stat-num">{{joinDays}}</text>
      <text class="stat-label">加入天数</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="onContact">
      <text class="menu-icon">🛎️</text>
      <text class="menu-text">帮助与反馈</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
