// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// --- 核心业务 ---

model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  nickname  String?
  avatarUrl String?
  points    Int      @default(0)
  level     Int      @default(1)
  
  // 收货信息
  realName  String?
  phone     String?
  address   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  records   Record[]
  orders    Order[]
  posts     Post[]
  comments  Comment[]
  complaints Complaint[]
  likes     Like[]
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  reward    Int
  type      String   // daily, weekly, once
  radius    Int      @default(50)
  isActive  Boolean  @default(true)
  
  // 坐标字段
  target_lat Float?
  target_lng Float?
  
  records   Record[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  image     String?
  stock     Int      @default(999)
  status    String   @default("active")  // active: 销售中, inactive: 已下架
  
  orders    Order[]
}

model Record {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, taskId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  points    Int
  status    String   @default("pending")
  remark    String?
  
  // 订单快照地址
  snapshotAddress String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Route {
  id      Int    @id @default(autoincrement())
  key     String @unique
  name    String
  points  String  // JSON 字符串: [{lat, lng, name}, ...]
}

// 兴趣点（POI）
model Poi {
  id          Int     @id @default(autoincrement())
  name        String
  lat         Float
  lng         Float
  description String  // 详细介绍
  category    String  @default("attraction")  // attraction: 景点, food: 美食, shopping: 购物
  image       String? // 图片 URL
  address     String? // 地址
  createdAt   DateTime @default(now())

  @@map("pois")  // 指定表名为 pois
}

// --- 社区模块 ---

model Post {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  images    String?
  likes     Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
  
  comments  Comment[]
  userLikes Like[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

// --- 客服模块 ---

model Complaint {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  content   String
  contact   String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}

// --- 系统配置 ---

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  desc      String?
}
